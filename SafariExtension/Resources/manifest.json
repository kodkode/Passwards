{
  "manifest_version": 3,
  "name": "Passwards",
  "version": "1.0",
  "description": "Fill and save Passwards logins in your browser.",
  "permissions": [
    "nativeMessaging",
    "storage",
    "activeTab",
    "tabs"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Passwards"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon128.png"
  },
  "browser_specific_settings": {
    "safari": {
      "strict_min_version": "18.4"
    }
  }
}
