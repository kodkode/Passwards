{
  "manifest_version": 3,
  "name": "2Password",
  "version": "1.0",
  "description": "Fill and save 2Password logins in your browser.",
  "key": "",
  "permissions": ["nativeMessaging", "storage", "activeTab", "tabs"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "2Password"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "128": "icon128.png"
  }
}
